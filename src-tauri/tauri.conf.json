{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevBar",
  "version": "0.6.1",
  "identifier": "dev.alperkosay.ada",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "bar",
        "title": "DevBar bar",
        "url": "index.html",
        "width": 300,
        "height": 30,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "pop",
        "title": "DevBar çekmece",
        "url": "pop.html",
        "width": 440,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      },
      {
        "label": "app",
        "title": "DevBar",
        "url": "app.html",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b0b0e",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
